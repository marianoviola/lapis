{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Lapislazuli: Compile",
			"type": "shell",
			"command": "npx",
			"args": ["--yes", "pnpm@10", "run", "compile"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$tsc", "$eslint-stylish"],
			"group": { "kind": "build", "isDefault": true }
		}
	]
}
