{
  "name": "lapis",
  "displayName": "Lapis",
  "icon": "media/lapis-icon.png",
  "description": "Lightweight knowledge navigation and structured views for plain Markdown workspaces.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/marianoviola/lapis.git"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage:markdown", "workspaceContains:**/.lapis"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": false }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": ["media/preview.css"],
    "commands": [
      {
        "command": "lapis.openNote",
        "title": "Open Note",
        "category": "Lapis"
      },
      {
        "command": "lapis.rebuildIndex",
        "title": "Rebuild Index",
        "category": "Lapis"
      },
      {
        "command": "lapis.insertWikilink",
        "title": "Insert Wikilink",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.format",
        "title": "Format Table",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.alignLeft",
        "title": "Align Column Left",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.alignCenter",
        "title": "Align Column Center",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.alignRight",
        "title": "Align Column Right",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.insertRowAbove",
        "title": "Insert Table Row Above",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.insertRowBelow",
        "title": "Insert Table Row Below",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.deleteRow",
        "title": "Delete Table Row",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.insertColumnLeft",
        "title": "Insert Table Column Left",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.insertColumnRight",
        "title": "Insert Table Column Right",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "lapis.table.deleteColumn",
        "title": "Delete Table Column",
        "category": "Lapis",
        "enablement": "editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lapis.insertWikilink",
          "when": "editorLangId == markdown",
          "group": "modification"
        },
        {
          "submenu": "lapis.table",
          "when": "editorLangId == markdown && lapis.inTable",
          "group": "modification"
        }
      ],
      "lapis.table": [
        { "command": "lapis.table.format", "group": "1_format" },
        { "command": "lapis.table.alignLeft", "group": "1_format" },
        { "command": "lapis.table.alignCenter", "group": "1_format" },
        { "command": "lapis.table.alignRight", "group": "1_format" },
        { "command": "lapis.table.insertRowAbove", "group": "2_rows" },
        { "command": "lapis.table.insertRowBelow", "group": "2_rows" },
        { "command": "lapis.table.deleteRow", "group": "2_rows" },
        { "command": "lapis.table.insertColumnLeft", "group": "3_columns" },
        { "command": "lapis.table.insertColumnRight", "group": "3_columns" },
        { "command": "lapis.table.deleteColumn", "group": "3_columns" }
      ]
    },
    "submenus": [{ "id": "lapis.table", "label": "Lapis: Table" }],
    "configuration": {
      "title": "Lapis",
      "properties": {
        "lapis.wikilinkCompletion": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Enable optional wikilink suggestions in the editor completion widget. Disabled by default to avoid competing with VS Code and Copilot suggestions; use Lapis: Insert Wikilink instead."
        },
        "lapis.excludedFolders": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "default": [".git", "node_modules", "dist", "out", ".vscode-test"],
          "scope": "resource",
          "description": "Directory names to exclude from the note index at any depth. Independent of Explorer and search exclusions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest:integration": "pnpm run compile-tests && pnpm run compile",
    "check-types": "tsc -p tsconfig.check.json",
    "lint": "eslint src tests",
    "test": "vitest run tests",
    "test:integration": "vscode-test --jobs 1"
  },
  "devDependencies": {
    "@types/github-slugger": "^1.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "github-slugger": "^1.5.0",
    "markdown-it": "^14.3.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "string-width": "^4.2.3",
    "yaml": "^2.9.1"
  }
}
